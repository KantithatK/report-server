<!doctype html>
<html lang="th">

<head>
  <meta charset="utf-8" />
  <title>Tax Invoice / Receipt {{doc.number}}</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      padding: 0;
      margin: 0;
    }

    body {
      font-family: "TH Sarabun New", "Sarabun", "Tahoma", Arial, sans-serif;
      color: #111;
      font-size: 14px;
      line-height: 1.25;
    }

    .page {
      width: 100%;
    }

    /* ===== Header ===== */
    .topbar {
      display: grid;
      grid-template-columns: 120px 1fr 110px;
      gap: 14px;
      align-items: start;
      margin-bottom: 6px;
    }

    .logo-box {
      width: 110px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo-img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      display: block;
    }

    .logo-text {
      font-size: 18px;
    }

    .company-block {
      padding-top: 2px;
    }

    .company-name {
      font-weight: 700;
      font-size: 18px;
    }

    .company-sub {
      font-size: 12px;
      margin-top: 2px;
    }

    .original-tag {
      justify-self: end;
      font-weight: 700;
      font-size: 16px;
      margin-top: 4px;
      text-align: right;
      line-height: 1.1;
    }

    .doc-title {
      text-align: center;
      font-size: 22px;
      font-weight: 800;
      margin: 8px 0 10px;
    }

    /* ===== SoldTo + Meta ===== */
    .info-row {
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 12px;
      margin-bottom: 10px;
      font-size: 14px;
    }

    .kv {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 6px;
    }

    .k {
      font-weight: 700;
      white-space: nowrap;
    }

    .addr {
      margin: 4px 0 6px 96px;
      font-size: inherit;
      white-space: pre-line;
    }

    .taxline {
      margin-top: 4px;
    }

    .docmeta {
      justify-self: end;
      width: 260px;
      font-size: inherit;
    }

    .docmeta .kv {
      grid-template-columns: 120px 1fr;
    }

    .docmeta .k {
      white-space: nowrap;
    }

    .docmeta .v {
      text-align: right;
    }

    /* ===== Table base ===== */
    table {
      border-collapse: collapse;
      width: 100%;
    }

    .qtable {
      border: 1px solid #333;
      table-layout: fixed;
      width: 100%;
    }

    .qtable th,
    .qtable td {
      border: 1px solid #333;
      padding: 8px 8px;
      vertical-align: top;
    }

    .qtable thead th {
      text-align: center;
      font-weight: 800;
      background: #f3f3f3;
    }

    .col-no {
      width: 60px;
    }

    .col-desc {
      width: auto;
    }

    .col-qty {
      width: 120px;
    }

    .col-unitprice {
      width: 120px;
    }

    .col-amount {
      width: 120px;
    }

    .center {
      text-align: center;
    }

    .right {
      text-align: right;
    }

    .desc-strong {
      font-weight: 700;
    }

    /* ===== Summary ===== */
    .qtable-summary {
      margin-top: 0;
      border-top: none;
    }

    .qtable-summary td {
      padding: 0 8px;
      vertical-align: middle;
    }

    .qtable-summary .note-cell {
      padding: 7px 8px;
      vertical-align: top;
    }

    .note-cell {
      font-size: 12px;
      white-space: pre-line;
      vertical-align: top;
    }

    .note-title {
      font-weight: 800;
      margin-bottom: 6px;
    }

    .note-text {
      white-space: pre-line;
    }

    .sum-label {
      background: #fafafa;
      text-align: center;
    }

    .sum-value {
      background: #fff;
    }

    .amount-words {
      text-align: center;
      font-weight: 800;
      padding: 9px 8px !important;
      background: #e9e9e9;
    }

    /* ===== Payment block ===== */
    .pay-block {
      margin-top: 0;
    }

    .pay-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin: 0;
    }

    .box {
      width: 12px;
      height: 12px;
      border: 1px solid #111;
      display: inline-block;
      transform: translateY(1px);
    }

    .line {
      border-bottom: 1px dotted #333;
      display: inline-block;
      min-width: 140px;
      transform: translateY(-2px);
    }

    .line.sm {
      min-width: 90px;
    }

    .line.xs {
      min-width: 70px;
    }

    /* ===== Signatures ===== */
    .sign-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 40px;
      margin-top: 38px;
      align-items: end;
      page-break-inside: avoid;
    }

    .sign-col {
      text-align: center;
    }

    .sign-label {
      font-size: 12px;
      margin-bottom: 6px;
    }

    .sign-line {
      border-bottom: 1px solid #333;
      height: 22px;
      margin-bottom: 0;
    }

    .sign-date {
      font-size: 12px;
      margin-top: 20px;
    }

    .sign-date .dots {
      border-bottom: 1px dotted #333;
      display: inline-block;
      width: 160px;
      transform: translateY(-2px);
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>

<body>
  <div class="page">

    <!-- Header -->
    <div class="topbar">
      <div class="logo-box">
        {{#if company.logo_url}}
        <img class="logo-img" src="{{company.logo_url}}" alt="logo" />
        {{else}}
        <div class="logo-text">โลโก้</div>
        {{/if}}
      </div>

      <div class="company-block">
        <div class="company-name">{{company.name}} (สำนักงานใหญ่)</div>
        <div class="company-sub">{{company.address}}</div>
        <div class="company-sub">เลขประจำตัวผู้เสียภาษี {{company.tax_id}}</div>
        <div class="company-sub">Tel: {{company.phone}} ต่อ 101,104 E-mail : {{company.email}}</div>
      </div>

      <div class="original-tag">ต้นฉบับ</div>
    </div>

    <div class="doc-title">ใบกำกับภาษี / ใบเสร็จรับเงิน</div>

    <!-- SoldTo + Doc Meta -->
    <div class="info-row">
      <div class="soldto">
        <div class="kv">
          <span class="k">ลูกค้า:</span>
          <span class="v"><strong>{{customer.name}}</strong></span>
        </div>
        <div class="addr">{{customer.address}}</div>

        <div class="kv taxline">
          <span class="k">เลขประจำตัวผู้เสียภาษี:</span>
          <span class="v">{{customer.tax_id}}</span>
        </div>
      </div>

      <div class="docmeta">
        <div class="kv"><span class="k">เลขที่เอกสาร</span><span class="v">{{doc.number}}</span></div>
        <div class="kv"><span class="k">วันที่เอกสาร</span><span class="v">{{doc.date}}</span></div>

        <div class="kv">
          <span class="k">อ้างอิงใบแจ้งหนี้ / ใบวางบิล</span>
          <span class="v">{{#if ref.billing_no}}{{ref.billing_no}}{{else}}-{{/if}}</span>
        </div>
        <div class="kv">
          <span class="k">วันที่อ้างอิงเอกสาร</span>
          <span class="v">{{#if ref.billing_date}}{{ref.billing_date}}{{else}}-{{/if}}</span>
        </div>
      </div>
    </div>

    <!-- Items Table -->
    <table class="qtable">
      <colgroup>
        <col class="col-no" />
        <col class="col-desc" />
        <col class="col-qty" />
        <col class="col-unitprice" />
        <col class="col-amount" />
      </colgroup>

      <thead>
        <tr>
          <th class="col-no">ลำดับ</th>
          <th class="col-desc">รายการ</th>
          <th class="col-qty">จำนวน</th>
          <th class="col-unitprice">หน่วยละ</th>
          <th class="col-amount">จำนวนเงิน</th>
        </tr>
      </thead>

      <tbody>
        {{#each items}}
        <tr class="item-row">
          <td class="center">{{no}}</td>
          <td>
            <div class="desc-strong">{{name}}</div>
          </td>
          <td class="center">{{qty}} {{unit}}</td>
          <td class="right">{{money price}}</td>
          <td class="right">{{money line_total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Summary + Note -->
    <table class="qtable qtable-summary">
      <colgroup>
        <col class="col-no" />
        <col class="col-desc" />
        <col class="col-qty" />
        <col class="col-unitprice" />
        <col class="col-amount" />
      </colgroup>

      <tbody>
        <tr>
          <td class="note-cell" colspan="3" rowspan="5">
            <div class="pay-row">
              <span class="box"></span> <span>เงินสด</span>
              <span class="box" style="margin-left: 20px;"></span> <span>เงินโอนเข้าบัญชี</span> <span class="line"></span>
              <span class="box" style="margin-left: 20px;"></span> <span>เช็คเลขที่</span> <span class="line sm"></span>
            </div>
            <div class="pay-row">
              <span>ธนาคาร</span> <span class="line sm"></span>
              <span>วันที่</span> <span class="line xs"></span>
              <span>จำนวนเงิน</span> <span class="line sm"></span>
            </div>
            {{#if note}}
            <div style="margin-top:8px;">
              <div class="note-title">หมายเหตุ :</div>
              <div class="note-text">{{note}}</div>
            </div>
            {{/if}}
          </td>

          <td class="sum-label">รวมเงิน</td>
          <td class="sum-value right">{{#if summary.total}}{{money summary.total}}{{else}}-{{/if}}</td>
        </tr>

        <tr>
          <td class="sum-label">หักคืนเงินจำ</td>
          <td class="sum-value right">
            {{#if summary.deposit_return}}-{{money summary.deposit_return}}{{else}}-{{/if}}
          </td>
        </tr>

        <tr>
          <td class="sum-label">มูลค่าสินค้าหลังหักเงินจำ</td>
          <td class="sum-value right">{{#if summary.after_deposit}}{{money summary.after_deposit}}{{else}}-{{/if}}</td>
        </tr>

        <tr>
          <td class="sum-label">ภาษีมูลค่าเพิ่ม 7%</td>
          <td class="sum-value right">{{#if summary.vat}}{{money summary.vat}}{{else}}-{{/if}}</td>
        </tr>

        <tr>
          <td class="sum-label"><strong>ยอดเงินสุทธิ</strong></td>
          <td class="sum-value right"><strong>{{#if summary.net_total}}{{money
              summary.net_total}}{{else}}-{{/if}}</strong></td>
        </tr>

        <tr>
          <td class="amount-words" colspan="5">
            {{#if summary.total_text}}{{summary.total_text}}{{else}}-{{/if}}
          </td>
        </tr>
      </tbody>
    </table>

    <!-- Signatures -->
    <div class="sign-row">
      <div class="sign-col">
        <div class="sign-label">ได้รับสินค้าตามรายการข้างบนเรียบร้อย<br />ผู้รับสินค้า</div>
        <div class="sign-line"></div>
        <div class="sign-date">วันที่ <span class="dots"></span></div>
      </div>

      <div class="sign-col">
        <div class="sign-label">ผู้ส่งสินค้า</div>
        <div class="sign-line"></div>
        <div class="sign-date">วันที่ <span class="dots"></span></div>
      </div>

      <div class="sign-col">
        <div class="sign-label">ในนาม "{{company.name}}"<br />ผู้มีอำนาจลงนาม</div>
        <div class="sign-line"></div>
        <div class="sign-date">วันที่ <span class="dots"></span></div>
      </div>
    </div>

  </div>
</body>

</html>