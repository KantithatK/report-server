<!doctype html>
<html lang="th">

<head>
  <meta charset="utf-8" />
  <link rel="stylesheet" href="/fonts/th-sarabun-new.css">
  <title>ใบเบิกเงินสดย่อย - {{doc.number}}</title>
  <style>
    

    * { box-sizing: border-box; }

    body {
      font-family: "Sarabun", sans-serif;
      font-size: 14px;
      line-height: 1.3;
      padding: 0;
      margin: 0;
      color: #000;
      background-color: #f0f0f0;
    }

    .page {
      width: 297mm;
      margin: 20px auto;
      padding: 12mm 14mm;
      min-height: 180mm;
      background-color: #fff;
      position: relative;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 5px;
    }

    .company-info {
      font-size: 14px;
      width: 70%;
    }

    .company-name {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 4px;
    }

    .logo-box {
      width: 30%;
      text-align: right;
    }

    .logo-box img {
      max-width: 120px;
      max-height: 80px;
      height: auto;
    }

    .header-line-thick {
      border-top: 4px solid #000;
      margin-top: 5px;
    }

    .header-line-thin {
      border-top: 1px solid #000;
      margin-top: 2px;
      margin-bottom: 20px;
    }

    .form-title {
      text-align: center;
      margin-bottom: 20px;
    }

    .form-title h1 {
      font-size: 20px;
      font-weight: bold;
      margin: 0;
    }

    .form-title span {
      font-size: 14px;
      font-weight: bold;
      text-transform: uppercase;
    }

    .info-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .info-left { width: 55%; }
    .info-right { width: 40%; }

    .input-row {
      display: flex;
      align-items: flex-end;
      margin-bottom: 8px;
    }

    .label {
      font-weight: bold;
      white-space: nowrap;
      margin-right: 5px;
    }

    .input-line {
      flex-grow: 1;
      border-bottom: 1px solid #000;
      min-height: 18px;
      padding-left: 5px;
    }

    .amount-box-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin-top: 5px;
    }

    .amount-box {
      border: 1px solid #000;
      padding: 4px 10px;
      min-width: 120px;
      text-align: right;
      font-weight: bold;
      margin: 0 5px;
      font-size: 16px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 5px;
      border: 1px solid #000;
    }

    th, td {
      border: 1px solid #000;
      padding: 8px 10px;
    }

    th {
      background-color: #f2f2f2;
      text-align: center;
      font-weight: bold;
    }

    .col-desc { width: 75%; }
    .col-amount { width: 25%; }

    .row-item {
      height: 30px;
    }

    .text-right { text-align: right; }
    .text-center { text-align: center; }

    .signature-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      border: 1px solid #000;
    }

    .signature-table td {
      border: 1px solid #000;
      width: 25%;
      text-align: center;
      vertical-align: top;
      padding: 0;
      height: 80px;
    }

    .sig-header {
      font-weight: bold;
      font-size: 12px;
      padding: 5px;
      border-bottom: 1px solid #000;
      display: block;
      background-color: #f9f9f9;
    }

    .sig-role {
      font-size: 13px;
      margin-top: 60px;
      display: block;
    }

    .footer-note {
      font-size: 12px;
      font-weight: bold;
    }

    @page {
      size: A4 landscape;
      margin: 0;
    }

    @media print {
      body { background-color: #fff; }
      .page { margin: 0; border: none; box-shadow: none; width: 100%; height: auto; }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="header-container">
      <div class="company-info">
        <div class="company-name">{{company.name}}</div>
        <div>{{company.address}}</div>
        <div>โทร. {{company.phone}}</div>
        <div>อีเมล: {{company.email}}</div>
      </div>
      <div class="logo-box">
        {{#if company.logo_url}}
          <img src="{{company.logo_url}}" alt="Logo">
        {{else}}
          <img src="https://via.placeholder.com/150x80?text=TR+LOGO" alt="Logo">
        {{/if}}
      </div>
    </div>

    <div class="header-line-thick"></div>
    <div class="header-line-thin"></div>

    <div class="form-title">
      <h1>ใบเบิกเงินสดย่อย</h1>
    </div>

    <div class="info-section">
      <div class="info-left">
        <div class="input-row">
          <span class="label">จ่ายให้กับ :</span>
          <div class="input-line">{{safeText form.paid_to ""}}</div>
        </div>
        <div class="input-row">
          <span class="label">สาเหตุที่ต้องซื้อ :</span>
          <div class="input-line">{{safeText form.purpose ""}}</div>
        </div>
      </div>

      <div class="info-right">
        <div class="input-row">
          <span class="label" style="width: 180px; text-align:right;">วันที่ :</span>
          <div class="input-line">{{safeText doc.date ""}}</div>
        </div>
        <div class="input-row">
          <span class="label" style="width: 180px; text-align:right;">เลขที่เอกสาร :</span>
          <div class="input-line">{{doc.number}}</div>
        </div>
        <div class="input-row">
          <span class="label" style="width: 180px; text-align:right;">แผนก :</span>
          <div class="input-line">{{safeText doc.department ""}}</div>
        </div>
        <div class="amount-box-row">
          <span class="label">จำนวนเงินที่จ่าย :</span>
          <div class="amount-box">{{money summary.total}}</div>
          <span class="label">บาท</span>
        </div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th class="col-desc">รายละเอียด</th>
          <th class="col-amount">จำนวน (บาท)</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr class="row-item">
            <td>{{description}}</td>
            <td class="text-right">{{#if has_amount}}{{money amount}}{{/if}}</td>
          </tr>
        {{/each}}

        <tr class="total-row">
          <td class="text-right" style="font-weight: bold;">ยอดรวม</td>
          <td class="text-right" style="font-weight: bold; background-color: #f9f9f9;">{{money summary.total}}</td>
        </tr>
      </tbody>
    </table>

    <table class="signature-table">
      <tr>
        <td>
          <span class="sig-header">ผู้รับเงิน</span>
        </td>
        <td>
          <span class="sig-header">อนุมัติโดย</span>
        </td>
        <td>
          <span class="sig-header">ตรวจสอบเอกสารโดย</span>
        </td>
        <td>
          <span class="sig-header">ร้องขอโดย</span>
        </td>
      </tr>
    </table>

    <div class="footer-note">{{safeText footer_note ""}}</div>

  </div>
</body>

</html>
