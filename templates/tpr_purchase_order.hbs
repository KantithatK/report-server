<!doctype html>
<html lang="th">

<head>
    <meta charset="utf-8" />
  <link rel="stylesheet" href="/fonts/th-sarabun-new.css">
  
    
    <title>ใบสั่งซื้อ / ใบสั่งจ้าง {{doc.number}}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            padding: 0;
            margin: 0;
        }

        body {
            font-family: "TH Sarabun New", "Sarabun", "Tahoma", Arial, sans-serif;
            color: #111;
            font-size: 14px;
            line-height: 1.25;
        }

        .page {
            width: 100%;
            padding: 20px;
        }

        /* ===== Header (เหมือนใบแจ้งหนี้) ===== */
        .topbar {
            display: grid;
            grid-template-columns: 120px 1fr 110px;
            gap: 14px;
            align-items: start;
            margin-bottom: 6px;
        }

        .logo-box {
            width: 110px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
        }

        .logo-text {
            font-size: 18px;
        }

        .company-block {
            padding-top: 2px;
        }

        .company-name {
            font-weight: 700;
            font-size: 18px;
        }

        .company-sub {
            font-size: 12px;
            margin-top: 2px;
        }

        .original-tag {
            justify-self: end;
            font-weight: 700;
            font-size: 16px;
            margin-top: 4px;
        }

        .doc-title {
            text-align: center;
            font-size: 22px;
            font-weight: 800;
            margin: 8px 0 10px;
        }

        /* ===== SoldTo + Meta ===== */
        .info-row {
            display: grid;
            grid-template-columns: 1fr 260px;
            gap: 12px;
            margin-bottom: 10px;
            font-size: 14px;
        }

        .kv {
            display: grid;
            grid-template-columns: 90px 1fr;
            gap: 6px;
        }

        .k {
            font-weight: 700;
            white-space: nowrap;
        }

        .addr {
            margin: 4px 0 6px 96px;
            /* = 90 + gap 6 */
            font-size: inherit;
            white-space: pre-line;
        }

        .taxline {
            margin-top: 4px;
        }

        .docmeta {
            justify-self: end;
            width: 260px;
            font-size: inherit;
        }

        .docmeta .kv {
            grid-template-columns: 120px 1fr;
        }

        .docmeta .k {
            white-space: nowrap;
        }

        .docmeta .v {
            text-align: right;
        }

        /* ===== Table base ===== */
        table {
            border-collapse: collapse;
            width: 100%;
        }

        .qtable {
            border: 1px solid #333;
            table-layout: fixed;
            width: 100%;
        }

        .qtable th,
        .qtable td {
            border: 1px solid #333;
            padding: 8px 8px;
            vertical-align: top;
        }

        .qtable thead th {
            text-align: center;
            font-weight: 800;
            background: #f3f3f3;
        }

        .col-no {
            width: 60px;
        }

        .col-desc {
            width: auto;
        }

        .col-qty {
            width: 120px;
        }

        .col-unitprice {
            width: 120px;
        }

        .col-amount {
            width: 120px;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .desc-strong {
            font-weight: 700;
        }

        /* ===== Summary ===== */
        .qtable-summary {
            margin-top: 0;
            border-top: none;
        }

       

        .note-cell {
            font-size: 12px;
            white-space: pre-line;
            vertical-align: top;
        }

        .note-title {
            font-weight: 800;
            margin-bottom: 4px;
        }

        .note-text {
            white-space: pre-line;
        }

        .sum-label {
            background: #fafafa;
        }

        .sum-value {
            background: #fff;
        }

        .amount-words {
            text-align: center;
            font-weight: 800;
            padding: 9px 8px !important;
            background: #e9e9e9;
        }

        /* ===== Message & Signature Box ===== */
        .closing-message {
            text-align: right;
            margin-top: 20px;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .signature-box {
            border: 1px solid #333;
            padding: 10px;
            margin-top: 10px;
            width: 220px;
            min-height: 80px;
            text-align: center;
            margin-left: auto;
        }

        .signature-title {
            font-weight: 700;
            margin-bottom: 25px;
            font-size: 13px;
        }

        .signature-line {
            display: inline-block;
            border-bottom: 1px solid #333;
            width: 150px;
            margin: 0 5px;
        }

        /* ===== Confirmation box ===== */
        .confirmation-box {
            border: 1px solid #333;
            padding: 10px 12px;
            margin-top: 18px;
            width: 100%;
            font-size: 13px;
        }

        .confirmation-text {
            line-height: 1.3;
            white-space: normal;
        }

        .confirmation-sign-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 40px;
            margin-top: 14px;
            text-align: center;
        }

        .confirmation-sign-label {
            font-size: 12px;
            margin-bottom: 6px;
        }

        .confirmation-sign-line {
            border-bottom: 1px solid #333;
            height: 22px;
        }

        .confirmation-footnote {
            margin-top: 8px;
            font-size: 11px;
            line-height: 1.25;
        }

        @media print {
            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>

<body>
    <div class="page">

        <!-- Header -->
        <div class="topbar">
            <div class="logo-box">
                {{#if company.logo_url}}
                <img class="logo-img" src="{{company.logo_url}}" alt="logo" />
                {{else}}
                <div class="logo-text">LOGO</div>
                {{/if}}
            </div>

            <div class="company-block">
                <div class="company-name">{{company.name}}{{#if company.branch}} ({{company.branch}}){{else}}
                    (สำนักงานใหญ่){{/if}}</div>
                <div class="company-sub">{{company.address}}</div>
                <div class="company-sub">เลขประจำตัวผู้เสียภาษี {{company.tax_id}}</div>
                <div class="company-sub">Tel: {{company.phone}} E-mail : {{company.email}}</div>
            </div>

            <div class="original-tag"></div>
        </div>

        <div class="doc-title">ใบสั่งซื้อ / ใบสั่งจ้าง</div>

        <!-- Vendor + Doc Meta -->
        <div class="info-row">
            <div class="soldto">
                <div class="kv">
                    <span class="k">เรียน:</span>
                    <span class="v"><strong>{{safeText vendor.name}}</strong></span>
                </div>
                <div class="addr">{{vendor.address}}</div>

                <div class="kv taxline">
                    <span class="k">เลขประจำตัวผู้เสียภาษี:</span>
                    <span class="v">{{safeText vendor.tax_id}}</span>
                </div>
            </div>

            <div class="docmeta">
                <div class="kv"><span class="k">เลขที่</span><span class="v">{{doc.number}}</span></div>
                <div class="kv"><span class="k">วันที่</span><span class="v">{{doc.date}}</span></div>
                <div class="kv"><span class="k">ครบกำหนด</span><span class="v">{{safeText doc.due_date ""}}</span></div>
                <div class="kv"><span class="k">ผู้จัดทำ</span><span class="v">{{safeText doc.buyer ""}}</span></div>
                <div class="kv"><span class="k">ชื่องาน</span><span class="v">{{safeText doc.project_name ""}}</span></div>
                {{#if doc.quotation_no}}<div class="kv"><span class="k">อ้างอิง QT</span><span class="v">{{safeText doc.quotation_no ""}}</span></div>{{/if}}
                {{#if doc.ref_docs.length}}
                <div class="kv"><span class="k">เอกสารอ้างอิง</span><span class="v">{{#each doc.ref_docs}}{{this.doc_no}}{{#unless @last}}, {{/unless}}{{/each}}</span></div>
                {{/if}}
            </div>
        </div>

        <!-- Items Table -->
        <table class="qtable">
            <colgroup>
                <col class="col-no" />
                <col class="col-desc" />
                <col class="col-qty" />
                <col class="col-unitprice" />
                <col class="col-amount" />
            </colgroup>

            <thead>
                <tr>
                    <th class="col-no">ลำดับ</th>
                    <th class="col-desc">รายการ</th>
                    <th class="col-qty">จำนวน</th>
                    <th class="col-unitprice">หน่วยละ</th>
                    <th class="col-amount">จำนวนเงิน</th>
                </tr>
            </thead>

            <tbody>
                {{#each items}}
                <tr class="item-row">
                    <td class="center">{{no}}</td>
                    <td>
                        <div>{{name}}</div>
                        {{#if description}}
                        <div style="font-size:12px; white-space:pre-line; margin-top:2px;">{{description}}</div>
                        {{/if}}
                    </td>
                    <td class="center">{{qty}} {{unit}}</td>
                    <td class="right">{{money price}}</td>
                    <td class="right">{{money line_total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <!-- Summary + Note -->
        <table class="qtable qtable-summary">
            <colgroup>
                <col class="col-no" />
                <col class="col-desc" />
                <col class="col-qty" />
                <col class="col-unitprice" />
                <col class="col-amount" />
            </colgroup>

            <tbody>
                <tr>
                    <td class="note-cell" colspan="3" rowspan="3">
                        <div class="note-title">{{safeText notes.title "หมายเหตุ :"}}</div>
                        <div class="note-text">{{safeText notes.text ""}}</div>
                    </td>

                    <td class="sum-label right">รวมเงิน</td>
                    <td class="sum-value right">{{money summary.subtotal}}</td>
                </tr>

                <tr>
                    <td class="sum-label right">ภาษีมูลค่าเพิ่ม 7%</td>
                    <td class="sum-value right">{{money summary.vat}}</td>
                </tr>

                <tr>
                    <td class="sum-label right"><strong>รวมเงินทั้งสิ้น</strong></td>
                    <td class="sum-value right"><strong>{{money summary.total}}</strong></td>
                </tr>

                <tr>
                    <td class="amount-words" colspan="5">{{safeText summary.total_text}}</td>
                </tr>
            </tbody>
        </table>

        <!-- Closing Message -->
        <div class="closing-message">{{safeText closing_message ""}}</div>

        <!-- Signature Box -->
        <div class="signature-box">
            <div class="signature-title">{{safeText signature.title "ผู้จัดทำเอกสาร"}}</div>
            <div>
                ลงชื่อ <span class="signature-line"></span>
            </div>
        </div>

        <!-- Confirmation Box -->
        <div class="confirmation-box">
            <div class="confirmation-text">{{safeText confirmation.text ""}}</div>
            <div class="confirmation-sign-row">
                <div>
                    <div class="confirmation-sign-label">{{safeText confirmation.sign1_label "ผู้มีอำนาจ"}}</div>
                    <div class="confirmation-sign-line"></div>
                </div>

                <div>
                    <div class="confirmation-sign-label">{{safeText confirmation.sign2_label "ประทับตราหน่วยงาน"}}</div>
                    {{!-- <div class="confirmation-sign-line"></div> --}}
                </div>
            </div>

        </div>

        <div class="confirmation-footnote">{{safeText confirmation.footnote ""}}</div>
    </div>
</body>

</html>