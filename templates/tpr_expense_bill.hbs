<!doctype html>
<html lang="th">

<head>
  <meta charset="utf-8" />
  <link rel="stylesheet" href="/fonts/th-sarabun-new.css">


  <title>Expense Note {{doc.number}}</title>

  <style>
    * { box-sizing: border-box; }
    html, body { padding: 0; margin: 0; }
    body {
      font-family: "TH Sarabun New", "Sarabun", "Tahoma", Arial, sans-serif;
      color: #000;
      font-size: 16px;
      line-height: 1.16;
    }
    .page { width: 100%; min-height: 270mm; position: relative; }
    .page-content { padding-bottom: 200px; }

    .doc-title { text-align: left; font-size: 26px; font-weight: 800; margin: 0 0 22px; }
    .header-row {
      display: grid;
      grid-template-columns: 1fr 240px;
      gap: 20px;
      align-items: start;
      margin-bottom: 4px;
    }
    .logo-box {
      width: 72px;
      height: 58px;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      margin-left: 24px;
      margin-bottom: 2px;
    }
    .logo-img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
    .logo-text { color: #777; font-size: 14px; padding-top: 18px; }
    .company-name { font-weight: 800; }
    .company-sub { margin-top: 1px; }

    .company-col { align-self: start; }
    .doc-col { align-items: stretch; align-self: start; }
    .meta-list { width: 240px; }
    .meta-list + .meta-list { margin-top: 6px; }
    .meta-row {
      display: grid;
      grid-template-columns: 76px 1fr;
      column-gap: 8px;
      min-height: 14px;
      font-size: 16px;
      padding: 0;
    }
    .meta-row .mk { font-weight: 800; white-space: nowrap; }
    .meta-row .mv { text-align: left; white-space: pre-line; }

    .customer-block { margin: 12px 0 0; font-size: 16px; }
    .cust-label, .cust-name { font-weight: 800; }
    .cust-line { margin-top: 1px; }

    table { border-collapse: collapse; width: 100%; }
    .qtable { table-layout: fixed; border: 1px solid #000; margin-top: 4px; }
    .qtable th,
    .qtable td {
      border-left: 1px solid #000;
      border-right: 1px solid #000;
      padding: 3px 6px;
      vertical-align: top;
      font-size: 16px;
    }
    .qtable thead th {
      border-top: 1px solid #000;
      border-bottom: 1px solid #000;
      text-align: center;
      font-weight: 800;
      line-height: 1.08;
    }
    .qtable tbody tr.item-row td { border: 1px solid #000; height: 18px; }
    .qtable tbody tr.summary-start td { padding-top: 8px; }
    .qtable tbody tr.last-summary td { padding-bottom: 7px; }
    .qtable tbody tr.wht-divider td { border-top: 1px solid #000 !important; padding-top: 6px; }

    /* เส้นขอบขวาสุดของตารางบางมากตอนพิมพ์จริง (พิสูจน์แล้วว่าไม่เกี่ยวกับขอบกระดาษ) — เพิ่มความหนา
       เฉพาะเส้นขอบขวาสุด ไม่แตะเส้นด้านอื่น/เส้นคั่นคอลัมน์ระหว่างกลาง; ต้องมี selector ที่จำเพาะกว่า
       กฎ .item-row td { border: 1px } ด้านบนด้วย ไม่งั้นแถวรายการจะโดนทับกลับเป็น 1px */
    .qtable th:last-child,
    .qtable td:last-child,
    .qtable tbody tr.item-row td:last-child {
      border-right: 2px solid #000;
    }

    .col-no { width: 40px; }
    .col-desc { width: auto; }
    .col-category { width: 90px; }
    .col-qty { width: 64px; }
    .col-price { width: 92px; }
    .col-discount { width: 64px; }
    .col-tax { width: 50px; }
    .col-amount { width: 98px; }

    .center { text-align: center; }
    .right { text-align: right; }
    .desc-strong { font-weight: 400; }
    .desc-muted { white-space: pre-line; }
    .qty-cell { white-space: nowrap; }
    .summary-label { text-align: right; font-weight: 400; white-space: nowrap; }
    .summary-value { text-align: right; white-space: nowrap; }
    .amount-words-cell { font-weight: 800; vertical-align: top; }
    .no-border-right { border-right: 0 !important; }
    .no-border-left { border-left: 0 !important; }
    .no-border { border: 0 !important; }

    .footer-note { margin-top: 10px; font-size: 16px; }
    .note-title { font-weight: 800; }
    .note-text { white-space: pre-line; margin-top: 2px; }

    /* ===== Payment confirmation — รูปแบบเต็มตามที่ฝ่ายบัญชีขอ (เทียบ FlowAccount 2569-09-23) ===== */
    .pay-block { margin-top: 12px; font-size: 16px; width: 100%; }
    .pay-title { font-weight: 800; text-align: left; margin-bottom: 6px; }
    .pay-method-row { display: flex; justify-content: flex-start; align-items: center; flex-wrap: wrap; gap: 18px; margin-bottom: 10px; }
    .chk-item { display: inline-flex; align-items: center; gap: 5px; }
    .chk-box {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 13px;
      height: 13px;
      border: 1.4px solid #333;
      flex-shrink: 0;
      box-sizing: border-box;
    }
    .chk-box.checked::after {
      content: '\2713';
      font-size: 10px;
      font-weight: 900;
      line-height: 1;
      transform: translateY(3px);
    }
    /* แถวเต็มความกว้าง — แต่ละฟิลด์มีเส้นขีดใต้เสมอ (ว่างก็ยังเห็นเส้น) เหมือนต้นแบบ */
    .pay-row { display: flex; align-items: flex-end; width: 100%; gap: 14px; margin-top: 10px; }
    .pay-field { display: flex; align-items: flex-end; flex: 1; gap: 4px; white-space: nowrap; }
    .pay-field .pay-label { flex-shrink: 0; }
    .pay-value {
      flex: 1;
      border-bottom: 1px dotted #333;
      min-height: 15px;
      padding: 0 4px 1px;
      font-weight: 800;
      text-align: center;
    }

    .bottom-fixed {
      position: fixed;
      bottom: 18mm;
      left: 0;
      right: 0;
    }
    /* ===== Signature block — เต็มความกว้าง 3 คอลัมน์เท่าฝั่งต้นแบบ (เทียบ FlowAccount 2569-09-23) ===== */
    .sign-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 24px;
      padding: 0;
      margin-top: 22px;
    }
    .sign-col { text-align: center; width: 100%; }
    .sign-label { font-weight: 800; margin-bottom: 4px; }
    .sign-name { min-height: 16px; }
    .sign-line { border-top: 1px solid #333; width: 100%; margin: 26px 0 8px; }
    .sign-name-row { display: flex; align-items: baseline; gap: 2px; margin-bottom: 6px; }
    .sign-name-line { flex: 1; border-bottom: 1px dotted #333; min-height: 13px; }
    .sign-date-row { margin-top: 4px; text-align: left; }
    .sign-date-label { font-weight: 800; font-size: 14px; }
    .sign-date-line { border-bottom: 1px dotted #666; display: inline-block; width: 120px; margin-left: 4px; }

    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>

<body>
  <div class="page">
  <div class="page-content">
    <!-- Header: บริษัท (ซ้าย, ผู้จ่ายเงิน) + บันทึกค่าใช้จ่าย + เมตา (ขวา) -->
    <div class="header-row">
      <div class="company-col">
        <div class="logo-box">
          {{#if company.logo_url}}
          <img class="logo-img" src="{{company.logo_url}}" alt="logo" />
          {{else}}
          <div class="logo-text">โลโก้</div>
          {{/if}}
        </div>
        <div class="company-name">{{company.name}}</div>
        <div class="company-sub">{{#if company.branch}}{{company.branch}} {{/if}}{{company.address_line1}}</div>
        {{#if company.address_line2}}<div class="company-sub">{{company.address_line2}}</div>{{/if}}
        <div class="company-sub">เลขประจำตัวผู้เสียภาษี {{company.tax_id}}</div>
        {{#if company.phone}}<div class="company-sub">โทรศัพท์ {{company.phone}}{{#if company.mobile}} เบอร์มือถือ {{company.mobile}}{{/if}}</div>{{else}}{{#if company.mobile}}<div class="company-sub">เบอร์มือถือ {{company.mobile}}</div>{{/if}}{{/if}}
        {{#if company.email}}<div class="company-sub">Email : {{company.email}}</div>{{/if}}
        {{#if company.website}}<div class="company-sub">{{company.website}}</div>{{/if}}

        <div class="customer-block">
          <div class="cust-label">ผู้จำหน่าย</div>
          <div class="cust-name">{{vendor.name}}</div>
          {{#if vendor.address}}<div class="cust-line">{{vendor.address}}</div>{{/if}}
          {{#if vendor.tax_id}}<div class="cust-line">เลขประจำตัวผู้เสียภาษี {{vendor.tax_id}}</div>{{/if}}
        </div>
      </div>

      <div class="doc-col">
        <div class="doc-title">บันทึกค่าใช้จ่าย</div>

        <div class="meta-list">
          <div class="meta-row"><span class="mk">เลขที่</span><span class="mv">{{doc.number}}</span></div>
          <div class="meta-row"><span class="mk">วันที่</span><span class="mv">{{doc.date}}</span></div>
          {{#if doc.credit_days}}
          <div class="meta-row"><span class="mk">เครดิต</span><span class="mv">{{doc.credit_days}}</span></div>
          {{/if}}
          {{#if doc.reference_no}}
          <div class="meta-row"><span class="mk">เลขอ้างอิง</span><span class="mv">{{doc.reference_no}}</span></div>
          {{/if}}
          {{#if doc.prepared_by}}
          <div class="meta-row"><span class="mk">ผู้จัดทำ</span><span class="mv">{{doc.prepared_by}}</span></div>
          {{/if}}
        </div>

        <div class="meta-list">
          {{#if doc.project_name}}
          <div class="meta-row"><span class="mk">ชื่องาน</span><span class="mv">{{doc.project_name}}</span></div>
          {{/if}}
          {{#if doc.contact_name}}
          <div class="meta-row"><span class="mk">ผู้ติดต่อ</span><span class="mv">{{doc.contact_name}}{{#if doc.contact_title}} ({{doc.contact_title}}){{/if}}</span></div>
          {{/if}}
          {{#if doc.contact_phone}}
          <div class="meta-row"><span class="mk">เบอร์โทร</span><span class="mv">{{doc.contact_phone}}</span></div>
          {{/if}}
          {{#if doc.contact_email}}
          <div class="meta-row"><span class="mk">อีเมล</span><span class="mv">{{doc.contact_email}}</span></div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Items Table -->
    <table class="qtable">
      <colgroup>
        <col class="col-no" />
        <col class="col-desc" />
        <col class="col-category" />
        <col class="col-qty" />
        <col class="col-price" />
        <col class="col-discount" />
        <col class="col-tax" />
        <col class="col-amount" />
      </colgroup>
      <thead>
        <tr>
          <th class="col-no">ลำดับ</th>
          <th class="col-desc">รายละเอียด</th>
          <th class="col-category">หมวดหมู่</th>
          <th class="col-qty">จำนวน</th>
          <th class="col-price">ราคาต่อหน่วย</th>
          <th class="col-discount">ส่วนลด</th>
          <th class="col-tax">ภาษี</th>
          <th class="col-amount">มูลค่า</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr class="item-row">
          <td class="center">{{no}}</td>
          <td>
            <div class="desc-strong">{{name}}</div>
            {{#if description}}<div class="desc-muted">{{description}}</div>{{/if}}
          </td>
          <td class="center">{{#if category}}{{category}}{{else}}-{{/if}}</td>
          <td class="center">
            <span class="qty-cell">{{qty}} {{unit}}</span>
          </td>
          <td class="right">{{money price}}</td>
          <td class="right">{{discount_display}}</td>
          <td class="center">{{tax_display}}</td>
          <td class="right">{{money line_total}}</td>
        </tr>
        {{/each}}

        <tr class="summary-start">
          <td colspan="5" class="no-border-right"></td>
          <td colspan="2" class="summary-label no-border-left">รวมเป็นเงิน</td>
          <td class="summary-value">{{money summary.gross_subtotal}} บาท</td>
        </tr>
        {{#if summary.discount_total}}
        <tr>
          <td colspan="5" class="no-border"></td>
          <td colspan="2" class="summary-label no-border-left">ส่วนลดรวม</td>
          <td class="summary-value">-{{money summary.discount_total}} บาท</td>
        </tr>
        <tr>
          <td colspan="5" class="no-border"></td>
          <td colspan="2" class="summary-label no-border-left">ราคาหลังหักส่วนลด</td>
          <td class="summary-value">{{money summary.after_discount}} บาท</td>
        </tr>
        {{/if}}
        <tr>
          <td colspan="5" class="no-border-right"></td>
          <td colspan="2" class="summary-label no-border-left">มูลค่าที่ไม่มี/ยกเว้นภาษี</td>
          <td class="summary-value">{{money summary.exempt_amount}} บาท</td>
        </tr>
        <tr>
          <td colspan="5" class="no-border-right"></td>
          <td colspan="2" class="summary-label no-border-left">มูลค่าที่คำนวณภาษี</td>
          <td class="summary-value">{{money summary.taxable_amount}} บาท</td>
        </tr>
        {{#if summary.vat_enabled}}
        <tr>
          <td colspan="5" class="no-border-right"></td>
          <td colspan="2" class="summary-label no-border-left">ภาษีมูลค่าเพิ่ม{{#if summary.vat_rate_display}} {{summary.vat_rate_display}}%{{/if}}</td>
          <td class="summary-value">{{money summary.vat}} บาท</td>
        </tr>
        {{/if}}
        <tr class="{{#unless summary.wht_enabled}}last-summary{{/unless}}">
          <td colspan="5" class="no-border-right amount-words-cell">
            ({{#if summary.total_text}}{{summary.total_text}}{{else}}-{{/if}})
          </td>
          <td colspan="2" class="summary-label no-border-left">จำนวนเงินรวมทั้งสิ้น</td>
          <td class="summary-value">{{money summary.total}} บาท</td>
        </tr>
        {{#if summary.wht_enabled}}
        <tr class="wht-divider">
          <td colspan="5" class="no-border-right"></td>
          <td colspan="2" class="summary-label no-border-left">หักภาษี ณ ที่จ่าย{{#if summary.wht_percent}} {{summary.wht_percent}}%{{/if}}</td>
          <td class="summary-value">{{money summary.wht_amount}} บาท</td>
        </tr>
        <tr class="last-summary">
          <td colspan="5" class="no-border-right"></td>
          <td colspan="2" class="summary-label no-border-left">ยอดชำระ</td>
          <td class="summary-value">{{money summary.net_payable}} บาท</td>
        </tr>
        {{/if}}
      </tbody>
    </table>

    <!-- หมายเหตุ -->
    <div class="footer-note">
      <div class="note-title">{{#if notes.title}}{{notes.title}}{{else}}หมายเหตุ{{/if}}</div>
      {{#if notes.text}}<div class="note-text">{{notes.text}}</div>{{/if}}
    </div>

  </div><!-- /page-content -->

    <!-- การชำระเงิน + Signatures: fixed ติดกันด้านล่างสุดของหน้า (mirror tpr_tax_receipt.hbs เป๊ะ) -->
    <div class="bottom-fixed">
    <div class="pay-block">
      <div class="pay-title">รายละเอียดการชำระเงิน</div>
      <div class="pay-method-row">
        <span class="pay-label">ช่องทางการชำระเงิน:</span>
        <span class="chk-item"><span class="chk-box{{#if payment.is_cash}} checked{{/if}}"></span>เงินสด</span>
        <span class="chk-item"><span class="chk-box{{#if payment.is_cheque}} checked{{/if}}"></span>เช็ค</span>
        <span class="chk-item"><span class="chk-box{{#if payment.is_transfer}} checked{{/if}}"></span>โอนเงิน</span>
        <span class="chk-item"><span class="chk-box{{#if payment.is_credit_card}} checked{{/if}}"></span>บัตรเครดิต</span>
      </div>
      <div class="pay-row">
        <span class="pay-field"><span class="pay-label">ธนาคาร</span><span class="pay-value">{{#if payment}}{{#unless payment.is_cash}}{{payment.bank_name}}{{/unless}}{{/if}}</span></span>
        <span class="pay-field"><span class="pay-label">เลขที่</span><span class="pay-value">{{#if payment}}{{#unless payment.is_cash}}{{payment.cheque_no}}{{/unless}}{{/if}}</span></span>
        <span class="pay-field"><span class="pay-label">วันที่ชำระ</span><span class="pay-value">{{#if payment}}{{payment.date}}{{/if}}</span></span>
      </div>
      <div class="pay-row">
        <span class="pay-field"><span class="pay-label">ยอดชำระ</span><span class="pay-value">{{#if payment}}{{money payment.amount}} บาท{{/if}}</span></span>
        <span class="pay-field"><span class="pay-label">หัก ณ ที่จ่าย</span><span class="pay-value">{{#if payment}}{{money payment.withholding_amount}} บาท{{/if}}</span></span>
      </div>
    </div>

    <div class="sign-row">
      <div class="sign-col">
        <div class="sign-label">ผู้รับเงิน</div>
        <div class="sign-name">&nbsp;</div>
        <div class="sign-line"></div>
        <div class="sign-name-row">(<span class="sign-name-line">&nbsp;</span>)</div>
        <div class="sign-date-row"><span class="sign-date-label">วันที่:</span></div>
      </div>

      <div class="sign-col">
        <div class="sign-label">ผู้จัดทำ</div>
        <div class="sign-name">&nbsp;</div>
        <div class="sign-line"></div>
        <div class="sign-name-row">(<span class="sign-name-line">&nbsp;</span>)</div>
        <div class="sign-date-row"><span class="sign-date-label">วันที่:</span></div>
      </div>

      <div class="sign-col">
        <div class="sign-label">ผู้อนุมัติ</div>
        <div class="sign-name">
          &nbsp;
          {{#if doc.signature_image_url}}
          <img class="sign-image" src="{{doc.signature_image_url}}" alt="ลายเซ็น" style="max-height:36px;max-width:120px;object-fit:contain;" />
          {{/if}}
        </div>
        <div class="sign-line"></div>
        <div class="sign-name-row">(<span class="sign-name-line">&nbsp;</span>)</div>
        <div class="sign-date-row"><span class="sign-date-label">วันที่:</span></div>
      </div>
    </div>
    </div><!-- /bottom-fixed -->

  </div><!-- /page -->
</body>

</html>
