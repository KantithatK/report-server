<!doctype html>
<html lang="th">

<head>
  <meta charset="utf-8" />
  <link rel="stylesheet" href="/fonts/th-sarabun-new.css">
  
    
  <title>Quotation {{doc.number}}</title>

  <style>
    /* ===== Page base ===== */
    * { box-sizing: border-box; }
    html, body { padding: 0; margin: 0; }
    body {
      font-family: "TH Sarabun New", "Sarabun", "Tahoma", Arial, sans-serif;
      color: #111;
      font-size: 14px;
      line-height: 1.25;
    }
    .page { width: 100%; }

    /* ===== Header (2 col — ตัด ต้นฉบับ ออก) ===== */
    .topbar {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 14px;
      align-items: start;
      margin-bottom: 6px;
    }
    .logo-box {
      width: 110px; height: 80px;
      display: flex; align-items: center; justify-content: center;
    }
    .logo-img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
    .logo-text { font-size: 18px; }
    .company-block { padding-top: 2px; }
    .company-name { font-weight: 700; font-size: 18px; }
    .company-sub { font-size: 12px; margin-top: 2px; }

    .doc-title {
      text-align: center;
      font-size: 22px;
      font-weight: 800;
      margin: 8px 0 10px;
    }

    /* ===== SoldTo + Meta ===== */
    .info-row {
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 12px;
      margin-bottom: 10px;
      font-size: 14px;
    }
    .kv {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 6px;
    }
    .k { font-weight: 700; white-space: nowrap; }
    .addr { margin: 4px 0 6px 96px; font-size: inherit; white-space: pre-line; }
    .taxline { margin-top: 4px; }
    .docmeta { justify-self: end; width: 260px; font-size: inherit; }
    .docmeta .kv { grid-template-columns: 90px 1fr; }
    .docmeta .k { white-space: nowrap; }
    .docmeta .v { text-align: right; }

    /* ===== Table base ===== */
    table { border-collapse: collapse; width: 100%; }
    .qtable { border: 1px solid #333; table-layout: fixed; width: 100%; }
    .qtable th, .qtable td { border: 1px solid #333; padding: 8px 8px; vertical-align: top; }
    .qtable thead th { text-align: center; font-weight: 800; background: #f3f3f3; }

    .col-no       { width: 60px; }
    .col-desc     { width: auto; }
    .col-qty      { width: 120px; }
    .col-unitprice{ width: 120px; }
    .col-amount   { width: 120px; }

    .center { text-align: center; }
    .right  { text-align: right; }
    .desc-strong { font-weight: 700; }
    .desc-muted  { font-size: 12px; color: #333; margin-top: 2px; white-space: pre-line; }

    /* ===== Summary table ===== */
    .qtable-summary { margin-top: 0; border-top: none; }
    .qtable-summary td { padding: 7px 8px; }
    .note-cell { font-size: 12px; white-space: pre-line; vertical-align: top; }
    .note-title { font-weight: 800; margin-bottom: 4px; }
    .note-text  { white-space: pre-line; }
    .sum-label  { background: #fafafa; }
    .sum-value  { background: #fff; }
    .amount-words {
      text-align: center;
      font-weight: 800;
      padding: 9px 8px !important;
      background: #e9e9e9;
    }

    /* ===== เนื้อหาหลักเผื่อพื้นที่ footer signature ===== */
    .page-content { padding-bottom: 100px; }

    /* ===== Signatures — fixed ด้านล่างสุดของหน้า ===== */
    .sign-row {
      position: fixed;
      bottom: 20mm;
      left: 0;
      right: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      padding: 0 20px;
      align-items: end;
    }
    .sign-col { text-align: center; padding: 0 60px; }
    .sign-label { font-size: 12px; }
    .sign-line  { border-bottom: 1px dashed #333; height: 40px; margin-top: 10px; }

    /* ===== Print tweaks ===== */
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>

<body>
  <div class="page">
  <div class="page-content">
    <!-- Header (ไม่มี ต้นฉบับ) -->
    <div class="topbar">
      <div class="logo-box">
        {{#if company.logo_url}}
        <img class="logo-img" src="{{company.logo_url}}" alt="logo" />
        {{else}}
        <div class="logo-text">โลโก้</div>
        {{/if}}
      </div>

      <div class="company-block">
        <div class="company-name">{{company.name}} (สำนักงานใหญ่)</div>
        <div class="company-sub">{{company.address}}</div>
        <div class="company-sub">เลขประจำตัวผู้เสียภาษี {{company.tax_id}}</div>
        <div class="company-sub">Tel: {{company.phone}} ต่อ 101,104 E-mail : {{company.email}}</div>
      </div>
    </div>

    <div class="doc-title">ใบเสนอราคา</div>

    <!-- SoldTo + Doc Meta -->
    <div class="info-row">
      <div class="soldto">
        <div class="kv">
          <span class="k">ลูกค้า:</span>
          <span class="v"><strong>{{customer.name}}</strong></span>
        </div>
        <div class="addr">{{customer.address}}</div>
        <div class="kv taxline">
          <span class="k">เลขประจำตัวผู้เสียภาษี:</span>
          <span class="v">{{customer.tax_id}}</span>
        </div>
      </div>

      <!-- Doc meta: เลขที่ / วันที่ / ผู้จัดทำ / ชื่องาน -->
      <div class="docmeta">
        <div class="kv"><span class="k">เลขที่เอกสาร</span><span class="v">{{doc.number}}</span></div>
        <div class="kv"><span class="k">วันที่เอกสาร</span><span class="v">{{doc.date}}</span></div>
        <div class="kv">
          <span class="k">ผู้จัดทำ</span>
          <span class="v">{{#if doc.prepared_by}}{{doc.prepared_by}}{{else}}-{{/if}}</span>
        </div>
        <div class="kv">
          <span class="k">ชื่องาน</span>
          <span class="v">{{#if doc.project_name}}{{doc.project_name}}{{else}}-{{/if}}</span>
        </div>
      </div>
    </div>

    <!-- Items Table -->
    <table class="qtable">
      <colgroup>
        <col class="col-no" />
        <col class="col-desc" />
        <col class="col-qty" />
        <col class="col-unitprice" />
        <col class="col-amount" />
      </colgroup>
      <thead>
        <tr>
          <th class="col-no">ลำดับ</th>
          <th class="col-desc">รายละเอียด</th>
          <th class="col-qty">จำนวน</th>
          <th class="col-unitprice">หน่วย</th>
          <th class="col-amount">จำนวนเงิน</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr class="item-row">
          <td class="center">{{no}}</td>
          <td><div class="desc-strong">{{name}}</div></td>
          <td class="center">{{qty}}</td>
          <td>{{unit}}</td>
          <td class="right">{{money line_total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Summary + Note (3 แถว — ตัด WHT / ยอดโอน ออก) -->
    <table class="qtable qtable-summary">
      <colgroup>
        <col class="col-no" />
        <col class="col-desc" />
        <col class="col-qty" />
        <col class="col-unitprice" />
        <col class="col-amount" />
      </colgroup>
      <tbody>
        <tr>
          <td class="note-cell" colspan="3" rowspan="3">
            {{#if terms.bank_note}}
            <div class="note-title">หมายเหตุ :</div>
            <div class="note-text">{{terms.bank_note}}</div>
            {{/if}}
          </td>
          <td class="sum-label right">รวม</td>
          <td class="sum-value right">{{money summary.subtotal}}</td>
        </tr>

        <tr>
          <td class="sum-label right">ภาษีมูลค่าเพิ่ม 7%</td>
          <td class="sum-value right">{{money summary.vat}}</td>
        </tr>

        <tr>
          <td class="sum-label right"><strong>รวมทั้งสิ้น</strong></td>
          <td class="sum-value right"><strong>{{money summary.total}}</strong></td>
        </tr>

        <!-- รวมเป็นเงิน — แสดงจำนวนเงินภาษาไทยบาทถ้วน -->
        <tr>
          <td class="amount-words" colspan="5">
            {{#if summary.total_text}}{{summary.total_text}}{{else}}-{{/if}}
          </td>
        </tr>
      </tbody>
    </table>

  </div><!-- /page-content -->

    <!-- Signatures: fixed ด้านล่างสุดของหน้า -->
    <div class="sign-row">
      <div class="sign-col">
        <div class="sign-label">ผู้สั่งซื้อ</div>
        <div class="sign-line"></div>
      </div>

      <div class="sign-col">
        <div class="sign-label">ผู้อนุมัติ</div>
        <div class="sign-line"></div>
      </div>
    </div>

  </div><!-- /page -->
</body>

</html>
